# ==============================================================================
# Barcelona Taxi Transfer - Admin Dashboard & Driver Portal Environment Variables
# ==============================================================================

# Backend API Configuration
PORT=4001
ADMIN_API_PORT=4001
NODE_ENV=development
API_BASE_URL=http://localhost:4001
ADMIN_WEB_URL=http://localhost:3001
CUSTOMER_WEB_URL=http://localhost:3000

# Shared Supabase Database & Auth (Must match existing project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Stripe Payments (For balance checks & refunds)
STRIPE_SECRET_KEY=sk_test_placeholder_key_51ABC...
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_...

# Google Maps Platform (For live driver routing & distance checks)
GOOGLE_MAPS_API_KEY=AIzaSy_placeholder_google_maps_api_key_...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_placeholder_google_maps_api_key_...

# Web Push Notifications (VAPID Keys for instant phone & browser alerts on new bookings)
VAPID_PUBLIC_KEY=BExamplePublicKey_ReplaceWithGeneratedVapidKey...
VAPID_PRIVATE_KEY=ExamplePrivateKey_ReplaceWithGeneratedVapidKey...
VAPID_SUBJECT=mailto:admin@barcelonataxitransfer.com

# Admin Web Public Variables
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BExamplePublicKey_ReplaceWithGeneratedVapidKey...
