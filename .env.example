# Server Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Supabase Database & Auth (PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_placeholder_key_51ABC...
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key_51ABC...
STRIPE_WEBHOOK_SECRET=whsec_placeholder_webhook_secret_...

# Google Maps Platform (Places Autocomplete, Geocoding, Directions)
GOOGLE_MAPS_API_KEY=AIzaSy_placeholder_google_maps_api_key_...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy_placeholder_google_maps_api_key_...

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
