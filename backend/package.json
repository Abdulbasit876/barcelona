    "@nestjs/swagger": "^7.3.1",
    "@supabase/supabase-js": "^2.43.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pdfkit": "^0.15.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^15.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.8",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "@types/pdfkit": "^0.13.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
